@{
    ViewData["Title"] = "Tasks Minimal API";
}

<div class="container-fluid mt-4">

    <div class="row mb-4">
        <div class="col-12">
            <h2>Tasks - Minimal API</h2>
            <p class="text-muted">
                Administracion de tareas mediante
                ASP.NET Core Minimal API.
            </p>
        </div>
    </div>

    <!-- Mensajes de exito o error -->
    <div id="taskMessage"
         class="alert d-none"
         role="alert">
    </div>

    <!-- Formulario de creacion y edicion -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            <h5 id="formTitle" class="mb-0">
                Crear nueva tarea
            </h5>
        </div>

        <div class="card-body">

            <form id="taskForm">

                <input type="hidden" id="taskId" value="0" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="taskName"
                               class="form-label">
                            Nombre *
                        </label>

                        <input type="text"
                               id="taskName"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="taskStatus"
                               class="form-label">
                            Estado
                        </label>

                        <select id="taskStatus"
                                class="form-select">
                            <option value="Pending">
                                Pending
                            </option>
                            <option value="In Progress">
                                In Progress
                            </option>
                            <option value="Completed">
                                Completed
                            </option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label for="taskDescription"
                               class="form-label">
                            Descripcion
                        </label>

                        <textarea id="taskDescription"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label for="taskDueDate"
                               class="form-label">
                            Fecha de vencimiento
                        </label>

                        <input type="datetime-local"
                               id="taskDueDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label for="taskModifiedBy"
                               class="form-label">
                            Modificado por
                        </label>

                        <input type="text"
                               id="taskModifiedBy"
                               class="form-control"
                               value="PAW.Web" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            id="saveTaskButton"
                            class="btn btn-success">
                        Guardar tarea
                    </button>

                    <button type="button"
                            id="cancelTaskButton"
                            class="btn btn-secondary">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>
    </div>

    <!-- Listado de tareas -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white
            d-flex justify-content-between
            align-items-center">

            <h5 class="mb-0">Listado de tareas</h5>

            <button type="button"
                    id="reloadTasksButton"
                    class="btn btn-sm btn-light">
                Actualizar
            </button>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped
                    table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripcion</th>
                            <th>Estado</th>
                            <th>Vencimiento</th>
                            <th>Modificado por</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="tasksTableBody">
                        <tr>
                            <td colspan="7"
                                class="text-center">
                                Cargando tareas...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        "use strict";

        // Direccion de nuestra Minimal API.
        const TASKS_API_URL = "https://localhost:7147/tasks";

        let tasksList = [];

        // Elementos principales.
        const taskForm = document.getElementById("taskForm");
        const taskMessage = document.getElementById("taskMessage");
        const tasksTableBody = document.getElementById("tasksTableBody");

        // Mostrar mensajes al usuario.
        function showTaskMessage(message, isError = false) {
            taskMessage.textContent = message;

            taskMessage.className = isError
                ? "alert alert-danger"
                : "alert alert-success";
        }

        // Formatear fechas para la tabla.
        function formatTaskDate(value) {
            if (!value) {
                return "-";
            }

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return "-";
            }

            return date.toLocaleString("es-CR");
        }

        // Crear celdas sin insertar HTML inseguro.
        function addTextCell(row, value) {
            const cell = document.createElement("td");
            cell.textContent = value ?? "-";
            row.appendChild(cell);
            return cell;
        }

        // Crear botones de acciones.
        function createActionButton(text, className, onClick) {
            const button = document.createElement("button");

            button.type = "button";
            button.className = className;
            button.textContent = text;
            button.addEventListener("click", onClick);

            return button;
        }

        // ========================================
        // GET - OBTENER TODAS LAS TAREAS
        // ========================================

        async function loadTasks() {
            tasksTableBody.replaceChildren();

            const loadingRow = document.createElement("tr");
            const loadingCell = addTextCell(
                loadingRow,
                "Cargando tareas..."
            );
            loadingCell.colSpan = 7;
            loadingCell.className = "text-center";
            tasksTableBody.appendChild(loadingRow);

            try {
                const response = await fetch(TASKS_API_URL, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    throw new Error(
                        "Error al consultar tareas: " + response.status
                    );
                }

                tasksList = await response.json();

                renderTasks();

            } catch (error) {
                console.error(error);

                tasksTableBody.replaceChildren();

                const row = document.createElement("tr");
                const cell = addTextCell(
                    row,
                    "No se pudieron cargar las tareas."
                );

                cell.colSpan = 7;
                cell.className = "text-center text-danger";

                tasksTableBody.appendChild(row);

                showTaskMessage(error.message, true);
            }
        }

        // Mostrar tareas en la tabla.
        function renderTasks() {
            tasksTableBody.replaceChildren();

            if (tasksList.length === 0) {
                const row = document.createElement("tr");

                const cell = addTextCell(
                    row,
                    "No hay tareas registradas."
                );

                cell.colSpan = 7;
                cell.className = "text-center";

                tasksTableBody.appendChild(row);
                return;
            }

            tasksList.forEach(task => {
                const row = document.createElement("tr");

                addTextCell(row, task.id);
                addTextCell(row, task.name);
                addTextCell(row, task.description);
                addTextCell(row, task.status);
                addTextCell(row, formatTaskDate(task.dueDate));
                addTextCell(row, task.modifiedBy);

                const actionsCell = document.createElement("td");
                actionsCell.className = "text-nowrap";

                const editButton = createActionButton(
                    "Editar",
                    "btn btn-warning btn-sm me-2",
                    () => editTask(task.id)
                );

                const deleteButton = createActionButton(
                    "Eliminar",
                    "btn btn-danger btn-sm",
                    () => deleteTask(task.id)
                );

                actionsCell.appendChild(editButton);
                actionsCell.appendChild(deleteButton);

                row.appendChild(actionsCell);
                tasksTableBody.appendChild(row);
            });
        }

        // ========================================
        // GET POR ID - CARGAR TAREA PARA EDITAR
        // ========================================

        async function editTask(id) {
            try {
                const response = await fetch(
                    TASKS_API_URL + "/" + id
                );

                if (!response.ok) {
                    throw new Error("No se encontro la tarea.");
                }

                const task = await response.json();

                document.getElementById("taskId").value = task.id;
                document.getElementById("taskName").value =
                    task.name ?? "";

                document.getElementById("taskDescription").value =
                    task.description ?? "";

                document.getElementById("taskStatus").value =
                    task.status ?? "Pending";

                document.getElementById("taskDueDate").value =
                    task.dueDate
                        ? task.dueDate.substring(0, 16)
                        : "";

                document.getElementById("taskModifiedBy").value =
                    task.modifiedBy ?? "PAW.Web";

                document.getElementById("formTitle").textContent =
                    "Editar tarea #" + task.id;

                document.getElementById("saveTaskButton").textContent =
                    "Actualizar tarea";

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            } catch (error) {
                showTaskMessage(error.message, true);
            }
        }

        // ========================================
        // POST Y PUT - GUARDAR TAREA
        // ========================================

        taskForm.addEventListener("submit", async function(event) {
            event.preventDefault();

            const id = Number(
                document.getElementById("taskId").value
            );

            const isEditing = id > 0;

            const dueDateValue =
                document.getElementById("taskDueDate").value;

            const task = {
                id: id,
                name: document.getElementById("taskName")
                    .value.trim(),
                description: document.getElementById(
                    "taskDescription"
                ).value.trim(),
                status: document.getElementById(
                    "taskStatus"
                ).value,
                dueDate: dueDateValue || null,
                createdAt: null,
                lastModified: null,
                modifiedBy: document.getElementById(
                    "taskModifiedBy"
                ).value.trim()
            };

            if (!task.name) {
                showTaskMessage(
                    "El nombre es obligatorio.",
                    true
                );
                return;
            }

            const url = isEditing
                ? TASKS_API_URL + "/" + id
                : TASKS_API_URL;

            const method = isEditing ? "PUT" : "POST";

            const saveButton = document.getElementById(
                "saveTaskButton"
            );

            saveButton.disabled = true;

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify(task)
                });

                if (!response.ok) {
                    const details = await response.text();

                    throw new Error(
                        "No se pudo guardar la tarea. " +
                        response.status + " " + details
                    );
                }

                resetTaskForm();

                await loadTasks();

                showTaskMessage(
                    isEditing
                        ? "Tarea actualizada correctamente."
                        : "Tarea creada correctamente."
                );

            } catch (error) {
                console.error(error);
                showTaskMessage(error.message, true);

            } finally {
                saveButton.disabled = false;
            }
        });

        // ========================================
        // DELETE - ELIMINAR TAREA
        // ========================================

        async function deleteTask(id) {
            const confirmed = confirm(
                "¿Seguro que deseas eliminar la tarea #" +
                id + "?"
            );

            if (!confirmed) {
                return;
            }

            try {
                const response = await fetch(
                    TASKS_API_URL + "/" + id,
                    {
                        method: "DELETE"
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        "No se pudo eliminar la tarea. " +
                        response.status
                    );
                }

                await loadTasks();

                showTaskMessage(
                    "Tarea eliminada correctamente."
                );

            } catch (error) {
                console.error(error);
                showTaskMessage(error.message, true);
            }
        }

        // ========================================
        // LIMPIAR FORMULARIO
        // ========================================

        function resetTaskForm() {
            taskForm.reset();

            document.getElementById("taskId").value = 0;

            document.getElementById("formTitle").textContent =
                "Crear nueva tarea";

            document.getElementById("saveTaskButton").textContent =
                "Guardar tarea";

            document.getElementById("taskModifiedBy").value =
                "PAW.Web";
        }

        // Boton Cancelar.
        document.getElementById(
            "cancelTaskButton"
        ).addEventListener("click", resetTaskForm);

        // Boton Actualizar.
        document.getElementById(
            "reloadTasksButton"
        ).addEventListener("click", loadTasks);

        // Cargar las tareas al abrir la pagina.
        loadTasks();

    </script>
}