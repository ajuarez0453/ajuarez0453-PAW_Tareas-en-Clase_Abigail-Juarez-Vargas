@model IEnumerable<PAW.Models.DTO.InventoryDTO>

@{
    ViewData["Title"] = "Inventory Page";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Inventory</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Inventory
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Inventory ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Product ID</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var inventory in Model)
                            {
                                <tr>

                                    <td>
                                        @inventory.InventoryId
                                    </td>

                                    <td>
                                        @inventory.UnitPrice
                                    </td>

                                    <td>
                                        @inventory.UnitsInStock
                                    </td>

                                    <td>
                                        @inventory.ProductId
                                    </td>

                                    <td>
                                        @(inventory.DateAdded?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @(inventory.LastUpdated?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @inventory.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Edit"
                                               asp-route-id="@inventory.InventoryId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-info details-button"
                                                    data-id="@inventory.InventoryId">
                                                Details
                                            </button>

                                            <form asp-action="Delete"
                                                  asp-route-id="@inventory.InventoryId"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Are you sure you want to delete this inventory record?');">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center">
                                    No inventory records found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- PAGINATION -->

    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <!-- FIRST << -->

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="1">
                        &laquo;&laquo;
                    </a>

                </li>


                <!-- PREVIOUS < -->

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">
                        &laquo;
                    </a>

                </li>


                <!-- ... BEFORE -->

                @if (currentPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            ...
                        </span>
                    </li>
                }


                <!-- PAGE BEFORE -->

                @if (currentPage > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)">
                            @(currentPage - 1)
                        </a>

                    </li>
                }


                <!-- CURRENT PAGE -->

                <li class="page-item active">

                    <span class="page-link">
                        @currentPage
                    </span>

                </li>


                <!-- PAGE AFTER -->

                @if (currentPage < totalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)">
                            @(currentPage + 1)
                        </a>

                    </li>
                }


                <!-- ... AFTER -->

                @if (currentPage < totalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            ...
                        </span>
                    </li>
                }


                <!-- NEXT > -->

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">
                        &raquo;
                    </a>

                </li>


                <!-- LAST >> -->

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@totalPages">
                        &raquo;&raquo;
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


<!-- DETAILS MODAL -->

<div class="modal fade"
     id="detailsModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Inventory Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div id="detailsContent"
                 class="modal-body">
            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.querySelectorAll(".details-button")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    async function () {

                        const id = this.dataset.id;

                        const response =
                            await fetch(
                                `/Inventory/Details/${id}`
                            );

                        const html =
                            await response.text();

                        document.getElementById(
                            "detailsContent"
                        ).innerHTML = html;

                        const modal =
                            new bootstrap.Modal(
                                document.getElementById(
                                    "detailsModal"
                                )
                            );

                        modal.show();
                    }
                );

            });

    </script>

}}