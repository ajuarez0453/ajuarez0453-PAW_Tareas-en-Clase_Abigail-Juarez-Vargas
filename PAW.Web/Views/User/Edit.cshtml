@model PAW.Models.DTO.UserDTO

@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h2>Edit User</h2>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="UserId"
                       type="hidden" />

                <div class="mb-3">
                    <label asp-for="Username"
                           class="form-label">
                        Username
                    </label>

                    <input asp-for="Username"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash"
                           class="form-label">
                        Password Hash
                    </label>

                    <input asp-for="PasswordHash"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="RoleId"
                           class="form-label">
                        Role ID
                    </label>

                    <input asp-for="RoleId"
                           class="form-control" />
                </div>

                <div class="form-check mb-3">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>

                <div class="mb-3">
                    <label asp-for="ModifiedBy"
                           class="form-label">
                        Modified By
                    </label>

                    <input asp-for="ModifiedBy"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-warning">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>